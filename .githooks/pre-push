#!/bin/sh
# A push to master deploys (.github/workflows/deploy.yml), so master is the
# human owner's to push. Claude Code marks the shells it spawns with
# CLAUDECODE; a push typed by hand in a terminal of one's own passes through.
[ -n "$CLAUDECODE" ] || exit 0

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [ "$remote_ref" = "refs/heads/master" ]; then
    echo "pre-push: an agent session does not push to master (it deploys)." >&2
    echo "Push a branch instead; the owner integrates it." >&2
    exit 1
  fi
done
exit 0
